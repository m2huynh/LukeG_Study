write.csv(primary_summary, file.path(out_dir, "primary_model_summary.csv"), row.names = FALSE)
write.csv(multilevel_i2(fit_primary), file.path(out_dir, "multilevel_heterogeneity_I2.csv"), row.names = FALSE)
