# -----------------------------------------------------------------------------
# 8. exploratory study-level publication-bias/small-study checks
# -----------------------------------------------------------------------------
# Aggregate multiple effects to one precision-weighted effect per study before
# conventional funnel, Egger, Begg, and trim-and-fill analyses.
aggregate_to_study <- function(es, rho_effects = 0) {
  V_full <- make_sampling_V(es, rho_effects)
  pieces <- lapply(split(seq_len(nrow(es)), es$StudyID), function(idx) {
    Vb <- V_full[idx, idx, drop = FALSE]
    one <- rep(1, length(idx))
    W <- solve(Vb)
    vi_bar <- as.numeric(1 / (t(one) %*% W %*% one))
    yi_bar <- as.numeric(vi_bar * (t(one) %*% W %*% es$yi[idx]))
    data.frame(
      StudyID = as.character(es$StudyID[idx[1]]),
      Reference = paste(unique(es$Reference[idx]), collapse = "; "),
      k_effects = length(idx),
      yi = yi_bar,
      vi = vi_bar,
      sei = sqrt(vi_bar),
      stringsAsFactors = FALSE
    )
  })
  do.call(rbind, pieces)
}

study_es <- aggregate_to_study(es_primary, rho_effects = 0)
fit_study <- rma.uni(yi, vi, method = "REML", data = study_es, test = "knha")
egger <- tryCatch(regtest(fit_study, model = "rma", predictor = "sei"), error = function(e) e)
begg <- tryCatch(ranktest(fit_study), error = function(e) e)
fit_trimfill <- tryCatch(trimfill(fit_study), error = function(e) e)

pb <- data.frame(
  Analysis = c("Study-level random-effects estimate", "Egger regression test", "Begg rank-correlation test",
               "Trim-and-fill imputed studies", "Trim-and-fill adjusted estimate"),
  Statistic = c(
    as.numeric(coef(fit_study)[1]),
    if (inherits(egger, "error")) NA_real_ else egger$zval,
    if (inherits(begg, "error")) NA_real_ else begg$tau,
    if (inherits(fit_trimfill, "error")) NA_real_ else fit_trimfill$k0,
    if (inherits(fit_trimfill, "error")) NA_real_ else as.numeric(coef(fit_trimfill)[1])
  ),
  P_value = c(
    fit_study$pval,
    if (inherits(egger, "error")) NA_real_ else egger$pval,
    if (inherits(begg, "error")) NA_real_ else begg$pval,
    NA_real_,
    if (inherits(fit_trimfill, "error")) NA_real_ else fit_trimfill$pval
  ),
  CI_lower = c(
    fit_study$ci.lb,
    NA_real_, NA_real_, NA_real_,
    if (inherits(fit_trimfill, "error")) NA_real_ else fit_trimfill$ci.lb
  ),
  CI_upper = c(
    fit_study$ci.ub,
    NA_real_, NA_real_, NA_real_,
    if (inherits(fit_trimfill, "error")) NA_real_ else fit_trimfill$ci.ub
  ),
  Note = c(
    "One inverse-variance aggregated standardized mean change per study (k = 30)",
    if (inherits(egger, "error")) conditionMessage(egger) else "Exploratory; funnel asymmetry is not proof of publication bias",
    if (inherits(begg, "error")) conditionMessage(begg) else "Exploratory; limited power and high heterogeneity",
    "Exploratory sensitivity; not a definitive correction for publication bias",
    "Exploratory sensitivity; interpret cautiously under high heterogeneity"
  ),
  stringsAsFactors = FALSE
)
write.csv(study_es, file.path(out_dir, "study_level_effects_for_publication_bias.csv"), row.names = FALSE)
write.csv(pb, file.path(out_dir, "publication_bias_exploratory.csv"), row.names = FALSE)

