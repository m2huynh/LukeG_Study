# 2. Effect sizes and models
# -----------------------------------------------------------------------------
# SMCR = standardized mean change using raw-score (baseline SD) standardization.
# metafor::escalc(correct = TRUE) applies Hedges' small-sample bias correction.
make_effects <- function(data, measure = c("SMCR", "MC"), prepost_r = 0.5) {
  measure <- match.arg(measure)
  d <- data
  d$ri <- prepost_r
  # metafor's SMCR defines d = (m1i - m2i) / sd1i.  Supply baseline as
  # time 1 so the standardization is by baseline SD, then reverse the sign
  # to report improvement as post minus pre.
  es <- escalc(
    measure = measure,
    m1i = Mean_pre, m2i = Mean_post,
    sd1i = SD_pre, sd2i = SD_post,
    ni = ni, ri = ri,
    data = d,
    append = TRUE,
    correct = TRUE
  )
  es$yi <- -es$yi
  es
}

# 'rho_effects' is a separate sensitivity parameter for sampling-error correlation
# among multiple effects reported within the same study. It is not the pre/post r.
make_sampling_V <- function(es, rho_effects = 0) {
  V <- diag(es$vi)
  groups <- split(seq_len(nrow(es)), es$StudyID)
  for (idx in groups) {
    if (length(idx) > 1 && rho_effects != 0) {
      block <- rho_effects * tcrossprod(sqrt(es$vi[idx]))
      diag(block) <- es$vi[idx]
      V[idx, idx] <- block
    }
  }
  V
}

fit_ml <- function(es, rho_effects = 0, mods = NULL) {
  V <- make_sampling_V(es, rho_effects)
  if (is.null(mods)) {
    rma.mv(
      yi = yi,
      V = V,
      random = ~ 1 | StudyID/EffectSizeID,
      method = "REML",
      test = "t",
      data = es
    )
  } else {
    rma.mv(
      yi = yi,
      V = V,
      mods = mods,
      random = ~ 1 | StudyID/EffectSizeID,
      method = "REML",
      test = "t",
      data = es
    )
  }
}

# CR2 cluster-robust results respect the 30 study clusters.
cr2_table <- function(fit, cluster) {
  x <- as.data.frame(coef_test(fit, vcov = "CR2", cluster = cluster, test = "Satterthwaite"))
  x$term <- rownames(x)
  rownames(x) <- NULL
  x$ci.lb <- x$beta - qt(0.975, df = x$df_Satt) * x$SE
  x$ci.ub <- x$beta + qt(0.975, df = x$df_Satt) * x$SE
  x[, c("term", "beta", "SE", "df_Satt", "tstat", "p_Satt", "ci.lb", "ci.ub")]
}

model_summary <- function(label, fit, es) {
  ct <- cr2_table(fit, es$StudyID)[1, , drop = FALSE]
  pred <- tryCatch(predict(fit), error = function(e) NULL)
  data.frame(
    Analysis = label,
    Estimate = ct$beta,
    SE_CR2 = ct$SE,
    df_CR2 = ct$df_Satt,
    CI_lower_CR2 = ct$ci.lb,
    CI_upper_CR2 = ct$ci.ub,
    p_CR2 = ct$p_Satt,
    Sigma2_between_study = if (length(fit$sigma2) >= 1) fit$sigma2[1] else NA_real_,
    Sigma2_within_study = if (length(fit$sigma2) >= 2) fit$sigma2[2] else NA_real_,
    QE = fit$QE,
    Q_p = fit$QEp,
    PI_lower = if (!is.null(pred) && "pi.lb" %in% names(pred)) pred$pi.lb[1] else NA_real_,
    PI_upper = if (!is.null(pred) && "pi.ub" %in% names(pred)) pred$pi.ub[1] else NA_real_,
    stringsAsFactors = FALSE
  )
}

# Multilevel I² decomposition using the typical sampling variance from the
# fitted V matrix. The two random-effects components are study and effect
# level, respectively.
multilevel_i2 <- function(fit) {
  W <- solve(fit$V)
  P <- W - W %*% fit$X %*% solve(t(fit$X) %*% W %*% fit$X) %*% t(fit$X) %*% W
  v_typical <- (fit$k - fit$p) / sum(diag(P))
  denom <- sum(fit$sigma2) + v_typical
  data.frame(
    Typical_sampling_variance = v_typical,
    Sigma2_between_study = fit$sigma2[1],
    Sigma2_within_study = fit$sigma2[2],
    I2_between_study_percent = 100 * fit$sigma2[1] / denom,
    I2_within_study_percent = 100 * fit$sigma2[2] / denom,
    I2_total_percent = 100 * sum(fit$sigma2) / denom
  )
}

