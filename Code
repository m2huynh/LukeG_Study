# -----------------------------------------------------------------------------
# 7. Existing subgroup moderators, refit correctly (not threshold sensitivities)
# -----------------------------------------------------------------------------
summarize_factor_moderator <- function(es, variable, label, group_file, omnibus_file) {
  # -1 produces one corrected pooled estimate per level under a common
  # multilevel heterogeneity structure; CR2 CIs/test statistics are by study.
  f_groups <- as.formula(paste0("~ ", variable, " - 1"))
  fit_groups <- fit_ml(es, rho_effects = 0, mods = f_groups)
  groups <- cr2_table(fit_groups, es$StudyID)
  groups$Group <- sub(paste0("^", variable), "", groups$term)
  groups <- groups[, c("Group", "beta", "SE", "df_Satt", "tstat", "p_Satt", "ci.lb", "ci.ub")]

  f_difference <- as.formula(paste0("~ ", variable))
  fit_difference <- fit_ml(es, rho_effects = 0, mods = f_difference)
  C <- diag(length(coef(fit_difference)))[-1, , drop = FALSE]
  omnibus <- tryCatch(
    as.data.frame(Wald_test(fit_difference, constraints = C, vcov = "CR2",
                            cluster = es$StudyID, test = "HTZ")),
    error = function(e) data.frame(error = conditionMessage(e))
  )
  write.csv(groups, file.path(out_dir, group_file), row.names = FALSE)
  write.csv(omnibus, file.path(out_dir, omnibus_file), row.names = FALSE)
  list(groups = groups, omnibus = omnibus, fit_groups = fit_groups, fit_difference = fit_difference)
}

